{
	"name": "hh-shops",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "wrangler types && astro dev",
		"build": "wrangler types && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "wrangler types && astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"ci:lint": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:generate:custom": "drizzle-kit generate --custom",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:productie": "node --env-file=.env.productie scripts/migreren.ts",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"db:check-constraints": "node --env-file=.env scripts/check-constraints.ts",
		"import:contactsheet": "node --env-file=.env scripts/import/contactsheet.ts",
		"import:check": "node --env-file=.env scripts/import/index.ts --check",
		"import": "node --env-file=.env scripts/import/index.ts",
		"links:controleren": "node --env-file=.env scripts/oude-links-controleren.ts",
		"deploy": "astro build && wrangler deploy",
		"cf:types": "wrangler types",
		"cf:secrets": "wrangler secret list",
		"fotos:naar-r2": "node --env-file=.env scripts/fotos-naar-r2.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.3.1",
		"@better-auth/drizzle-adapter": "^1.6.31",
		"@fontsource-variable/geist": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.1",
		"astro-icon": "^1.2.0",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.6.31",
		"drizzle-orm": "^0.45.2",
		"entities": "^8.1.0",
		"jose": "^6.2.12",
		"pdf-lib": "^1.17.1",
		"sanitize-html": "^2.17.7",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.12",
		"@iconify-json/ph": "^1.2.2",
		"@types/pg": "^8.23.1",
		"@types/sanitize-html": "^2.16.1",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.10",
		"pg": "^8.23.0",
		"sharp": "^0.35.4",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0",
		"wrangler": "^4.131.2"
	},
	"private": true
}
