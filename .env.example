# TWEE BESTANDEN, want er zijn twee werelden.
#
#   .dev.vars   de dev-server (`astro dev`, `astro preview`). Die draait sinds
#               de overstap naar Cloudflare op workerd, en workerd leest dit
#               bestand. In productie staan dezelfde sleutels in Cloudflare,
#               gezet met `npx wrangler secret put <NAAM>`.
#
#   .env        drizzle-kit en de scripts in scripts/. Die draaien op Node,
#               buiten de Worker om, en zien .dev.vars niet.
#
# Kopieer wat je nodig hebt naar het juiste bestand. Geen van beide komt in git.
# Wat niet geheim is (OMGEVING, de cron) staat in wrangler.jsonc.

# ===========================================================================
# BEIDE
# ===========================================================================

# Neon-project "hhshops", eu-central-1, Postgres 18.
# De applicatie gebruikt de GEPOOLDE endpoint: host bevat -pooler. Veel korte
# verbindingen, dus PgBouncer ervoor.
DATABASE_URL=""

# Waar R2 de product- en categoriefoto's publiek serveert, zonder slotslash.
# De r2.dev-URL van de bucket staat in het Cloudflare-dashboard onder
# R2 > hh-shops-media > Settings > Public Development URL. Bij de livegang komt
# hier een eigen domein (media.hh-shops.nl); pas dan ook image.remotePatterns
# in astro.config.mjs aan.
R2_PUBLIC_URL=""

# ===========================================================================
# ALLEEN .dev.vars (en Cloudflare)
# ===========================================================================

# Better Auth, het geheim waarmee sessiecookies worden ondertekend.
# Minstens 32 tekens: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# "productie" op de echte winkel; iets anders lokaal. wrangler.jsonc zet hem al
# op "productie", dus lokaal zet je hem hier terug op "ontwikkel". Zonder dat
# weigert de nagebootste Mollie te draaien.
OMGEVING="ontwikkel"

# Mail via Resend. Sleutel met alleen verzendrechten, uit het eigen
# Resend-account van HH Shops. Ontbreekt hij, dan komen mails in de logs.
RESEND_API_KEY=""
# De afzender. Zolang hh-shops.nl bij Resend niet geverifieerd is, blijft dit
# leeg en gebruikt de code "HH Shops <onboarding@resend.dev>", dat alleen naar
# het eigen adres van de accounthouder mag sturen. Daarna:
# MAIL_FROM="HH Shops <noreply@hh-shops.nl>"
MAIL_FROM=""
# Zet op "log" om lokaal niets te versturen en de mails in de uitvoer van
# `astro dev` te zien, ook als er een sleutel staat.
MAIL_MODUS=""

# Mollie. De testsleutel (test_...) tot de livegang, daarna de livesleutel
# (live_...). Ontbreekt hij, dan gebruikt de shop buiten productie een
# nagebootste betaling met knoppen Betaald, Mislukt en Verlopen.
MOLLIE_API_KEY=""
# Zet op "nep" om die nagebootste betaling te gebruiken, ook met sleutel.
MOLLIE_MODUS=""
# Waar de eigenaar bericht krijgt van een nieuwe bestelling.
# Standaard info@hh-shops.nl; tijdens het testen bijvoorbeeld je eigen adres.
BESTELLING_MAIL_NAAR=""

# Beveiligt /api/cron/bestellingen-opschonen, de handmatige ingang van het
# opschonen. De dagelijkse cron gaat hier NIET langs: die komt binnen via
# scheduled() in src/worker.ts (wrangler.jsonc, triggers.crons) en heeft geen
# geheim nodig, want die aanroep komt van het platform en niet van buiten.
# Nieuwe waarde: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# ===========================================================================
# ALLEEN .env
# ===========================================================================

# Migraties gaan naar de DIRECTE endpoint: dezelfde host zonder -pooler, met
# ?sslmode=verify-full. drizzle-kit draait DDL in een transactie en dat hoort
# niet door een transaction-mode pooler; Neon raadt de pooler af voor migraties.
# Hoeft niet in Cloudflare te staan: daar draaien nooit migraties.
#
# Tegen productie draai je ze met `npm run db:migrate:productie`, dat
# .env.productie leest en eerst toont welke database het is.
DATABASE_URL_UNPOOLED=""

# R2 via de S3-API, voor `npm run import` en scripts/categorieen-overzetten.ts.
# Die scripts draaien buiten de Worker en hebben dus geen R2-binding.
#
# Het account-id staat rechtsboven in het R2-overzicht. De twee sleutels maak je
# in het dashboard: R2 > API > Manage API tokens > Create API token, rechten
# "Object Read & Write", beperkt tot de bucket. Zonder deze twee werkt alleen de
# import niet; de site draait gewoon.
R2_ACCOUNT_ID=""
R2_BUCKET="hh-shops-media"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Wachtwoord voor scripts/beheerder-aanmaken.ts en beheerder-wachtwoord.ts.
# Alleen invullen op het moment dat je zo'n script draait.
BEHEERDER_WACHTWOORD=""
