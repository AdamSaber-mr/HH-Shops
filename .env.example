# Kopieer naar .env en vul in. De .env zelf komt niet in git.
#
# Neon-project "HH Shops", eu-central-1, Postgres 18.
# Twee branches: `main` is productie, `dev` is voor lokaal werk en previews.
# Lokaal vul je hier de DEV-branch in, nooit main.

# De applicatie: GEPOOLDE endpoint (host bevat -pooler).
# Veel korte serverless-verbindingen, dus PgBouncer ervoor.
DATABASE_URL=""

# Migraties: DIRECTE endpoint (dezelfde host zonder -pooler),
# met ?sslmode=verify-full.
# drizzle-kit draait DDL in een transactie en dat hoort niet door een
# transaction-mode pooler. Neon raadt de pooler af voor migraties.
# Hoeft niet in Vercel te staan: daar draaien nooit migraties.
DATABASE_URL_UNPOOLED=""

# Vercel Blob, alleen nodig voor de import (npm run import).
# Twee manieren, de SDK kiest zelf:
#
# 1. Een tijdelijk OIDC-token, 12 uur geldig, plus het store-id. Beide komen
#    uit `vercel env pull` op een gekoppeld project, dus geen wachtwoord om
#    te bewaren. Verlopen? Opnieuw `vercel env pull`.
BLOB_STORE_ID=""
VERCEL_OIDC_TOKEN=""
#
# 2. Of een vast read-write token uit het Vercel-dashboard (Storage, de store,
#    tabblad Tokens). Dan mogen de twee hierboven leeg blijven.
BLOB_READ_WRITE_TOKEN=""

# Better Auth, het geheim waarmee sessiecookies worden ondertekend.
# Minstens 32 tekens, bijvoorbeeld: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Mail via Resend (wachtwoord vergeten, e-mailbevestiging, straks
# bestelbevestigingen). Sleutel met alleen verzendrechten, uit het eigen
# Resend-account van HH Shops. Ontbreekt hij, dan komen mails in de logs.
RESEND_API_KEY=""
# De afzender. Zolang hh-shops.nl bij Resend niet geverifieerd is, blijft dit
# leeg en gebruikt de code "HH Shops <onboarding@resend.dev>", dat alleen naar
# het eigen adres van de accounthouder mag sturen. Daarna:
# MAIL_FROM="HH Shops <noreply@hh-shops.nl>"
MAIL_FROM=""
# Zet op "log" om lokaal niets te versturen en de mails in `astro dev logs`
# te zien, ook als er een sleutel staat.
MAIL_MODUS=""

# Mollie. De testsleutel (test_...) tot de livegang, daarna de livesleutel
# (live_...). Ontbreekt hij, dan gebruikt de shop buiten productie een
# nagebootste betaling met knoppen Betaald, Mislukt en Verlopen.
MOLLIE_API_KEY=""
# Zet op "nep" om de nagebootste betaling te gebruiken, ook met sleutel.
MOLLIE_MODUS=""
# Uit Vercel (Settings, Deployment Protection, Protection Bypass for
# Automation), zodat de webhook van Mollie een preview kan bereiken.
VERCEL_AUTOMATION_BYPASS_SECRET=""
# Waar de eigenaar bericht krijgt van een nieuwe bestelling.
# Standaard info@hh-shops.nl; tijdens het testen bijvoorbeeld je eigen adres.
BESTELLING_MAIL_NAAR=""
