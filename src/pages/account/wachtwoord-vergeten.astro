---
import { actions } from 'astro:actions';
import Button from '../../components/Button.astro';
import Formulierveld from '../../components/klant/Formulierveld.astro';
import Melding from '../../components/klant/Melding.astro';
import Layout from '../../layouts/Layout.astro';
import { leesFormulier, veldfoutenUit } from '../../lib/admin/formulier.ts';

/*
 * Wachtwoord vergeten: een e-mailadres invullen, en als daar een account
 * bij hoort komt er een mail met een link naar /account/wachtwoord-herstellen.
 * Of het adres bestaat zeggen we niet; de melding is voor iedereen gelijk.
 *
 * Het veld "website" is een honeypot, net als bij registreren.
 */

const result = Astro.getActionResult(actions.klant.wachtwoordVergeten);
const verstuurd = Boolean(result && !result.error);
const { velden: fouten, algemeen } = veldfoutenUit(result?.error);
const ingevuld = result?.error ? (await leesFormulier(Astro.request)).velden : {};
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Wachtwoord vergeten" noindex>
	<div class="mx-auto max-w-md px-4 py-10 sm:px-6 lg:py-16">
		<h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Wachtwoord vergeten</h1>
		<p class="mt-2 text-text-muted">
			Vul het e-mailadres van je account in. Je krijgt een mail met een link waarmee je een nieuw
			wachtwoord kiest.
		</p>

		<div class="mt-6">
			{
				verstuurd ? (
					<Melding
						melding={{
							soort: 'ok',
							tekst:
								'Als dit adres bij ons bekend is, hebben we een mail gestuurd. De link daarin is een uur geldig. Kijk ook in je spam.',
						}}
					/>
				) : (
					<Melding melding={algemeen ? { soort: 'fout', tekst: algemeen } : null} />
				)
			}
		</div>

		{
			!verstuurd && (
				<form method="POST" action={actions.klant.wachtwoordVergeten} class="space-y-5" novalidate>
					<Formulierveld
						naam="email"
						label="E-mailadres"
						type="email"
						autocomplete="username"
						inputmode="email"
						verplicht
						waarde={ingevuld.email ?? ''}
						fout={fouten.email?.[0]}
					/>
					<div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
						<label for="veld-website">Website, laat dit veld leeg</label>
						<input id="veld-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>
					<Button type="submit" block size="lg">
						Stuur de mail
					</Button>
				</form>
			)
		}

		<p class="mt-6 text-sm">
			<a href="/account/inloggen" class="font-medium text-accent hover:underline">Terug naar inloggen</a>
		</p>
	</div>
</Layout>
