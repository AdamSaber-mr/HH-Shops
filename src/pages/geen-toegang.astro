---
import Button from '../components/Button.astro';
import Layout from '../layouts/Layout.astro';

/*
 * Een ingelogde klant die op /admin terechtkomt. Geen inlogscherm dat lijkt
 * te werken maar niets toont: gewoon zeggen wat er is, en de weg terug.
 */
Astro.response.status = 403;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Geen toegang" noindex>
	<div class="mx-auto max-w-lg px-4 py-16 text-center sm:px-6">
		<h1 class="text-2xl font-semibold">Hier heb je geen toegang toe</h1>
		<p class="mt-3 text-text-muted">
			Deze pagina is alleen voor het beheer van de winkel. Je bent ingelogd met een klantaccount.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<Button href="/account">Naar mijn account</Button>
			<Button href="/" variant="secondary">Naar de winkel</Button>
		</div>
	</div>
</Layout>
