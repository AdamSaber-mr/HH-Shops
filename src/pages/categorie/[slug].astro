---
import Button from '../../components/Button.astro';
import CategoryBanner from '../../components/CategoryBanner.astro';
import FilterBar from '../../components/FilterBar.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import Layout from '../../layouts/Layout.astro';
import {
	bannerFoto,
	bannerTekst,
	getCategoryBySlug,
	listProductsInCategory,
	verhuisdeCategorieSlug,
} from '../../lib/catalog.ts';
import {
	beschikbareOpties,
	defaultVariant,
	filterEnSorteer,
	heeftActieveFilters,
	leesFilter,
} from '../../lib/categorie-filters.ts';
import { leesFavorieten } from '../../lib/klanten/favorieten.ts';

/*
 * De categoriepagina: banner, filterbalk, kop met teller en het raster.
 *
 * Op telefoon staat boven de banner een korte inleiding: de naam van de
 * categorie, de eerste twee regels van de begeleidende tekst en een 'Lees
 * meer' dat de rest uitklapt. Die tekst past daar niet meer in de banner zelf
 * (die staat op telefoon naast elkaar, zie CategoryBanner.astro), en zo blijft
 * hij toch te lezen zonder de producten weg te duwen. Vanaf tablet verandert
 * er niets: daar staat de tekst gewoon in de banner en is de inleiding weg.
 *
 * Een pagina voor alle categorieen. De slug bepaalt de categorie; de tekst en
 * de foto in de banner komen uit de database (in te vullen in het
 * beheerpaneel). Is de slug in het paneel gewijzigd, dan verwijst de oude
 * door naar de nieuwe. Filters en sortering staan in de querystring en
 * worden in categorie-filters.ts uitgerekend.
 *
 * Twee lege staten: een categorie zonder producten (dan ook geen filterbalk,
 * er valt niets te filteren) en filters die niets opleveren (dan blijft de
 * balk staan, anders kun je niet terug).
 */

const { slug } = Astro.params;
if (!slug) return new Response(null, { status: 404, statusText: 'Niet gevonden' });

const [category, alle] = await Promise.all([getCategoryBySlug(slug), listProductsInCategory(slug)]);
if (!category) {
	const nieuw = await verhuisdeCategorieSlug(slug);
	if (nieuw) return Astro.redirect(`/categorie/${nieuw}${Astro.url.search}`, 301);
	return new Response(null, { status: 404, statusText: 'Niet gevonden' });
}

const opties = beschikbareOpties(alle);
const filter = leesFilter(
	Astro.url.searchParams,
	opties.map((o) => o.param),
);
const gefilterd = filterEnSorteer(alle, filter);

const entries = gefilterd
	.map((product) => ({
		product,
		variant: defaultVariant(product.variants),
		image: product.images[0],
	}))
	.filter(
		(entry): entry is typeof entry & { variant: NonNullable<typeof entry.variant> } =>
			Boolean(entry.variant && entry.image),
	);
const favorieten = new Set(await leesFavorieten(Astro));

const tekst = bannerTekst(category);
const pad = `/categorie/${category.slug}`;
const gefilterdActief = heeftActieveFilters(filter);
// Gefilterde en gesorteerde varianten van de pagina horen niet in Google.
const noindex = gefilterdActief || filter.sorteer !== 'naam';

const aantal = (n: number) => (n === 1 ? '1 product' : `${n} producten`);
const teller = gefilterdActief
	? `${gefilterd.length} van ${aantal(alle.length)}`
	: aantal(alle.length);
---

<Layout
	title={category.name}
	description={tekst.kort}
	noindex={noindex}
	deelAfbeelding={bannerFoto(category)?.url}
	deelAfbeeldingAlt={bannerFoto(category)?.alt}
>
	<div class="mx-auto max-w-[1400px] px-4 pt-5 sm:px-6">
		<nav aria-label="Kruimelpad" class="text-sm text-text-muted">
			<a href="/" class="rounded-control hover:text-text hover:underline">Home</a>
			<span aria-hidden="true" class="mx-2">/</span>
			<a href="/categorieen" class="rounded-control hover:text-text hover:underline">Categorieën</a>
			<span aria-hidden="true" class="mx-2">/</span>
			<span aria-current="page" class="text-text">{category.name}</span>
		</nav>

		<!-- Inleiding, alleen op telefoon. De naam staat hier als <p>: de h1 van de
		     pagina hoort bij het raster verderop, en een tweede kop erboven klopt
		     niet voor schermlezers en zoekmachines.

		     De tekst staat op twee regels afgekapt (line-clamp-2); 'Lees meer'
		     klapt de rest uit. Geen <details>: die verbergt zijn inhoud volledig
		     zolang hij dicht staat, en juist die eerste twee regels wil je zien.
		     Het knopje werkt net als de menu's in SiteHeader.astro op
		     aria-expanded, zodat een schermlezer de toestand meekrijgt. -->
		<div class="mt-3 sm:hidden">
			<p class="text-2xl font-bold tracking-tight">{category.name}</p>
			<p id="categorie-inleiding" class="mt-1.5 line-clamp-2 text-text-muted" data-inleiding>
				{tekst.tekst}
			</p>
			<button
				type="button"
				class="inline-flex min-h-9 items-center font-medium text-accent underline-offset-2 hover:underline"
				aria-expanded="false"
				aria-controls="categorie-inleiding"
				data-inleiding-knop
			>
				Lees meer
			</button>
		</div>
	</div>

	<div class="mt-4">
		<CategoryBanner
			image={bannerFoto(category)}
			eyebrow={tekst.eyebrow}
			title={tekst.titel}
			text={tekst.kort}
			cta={{ label: tekst.knop, href: '#producten' }}
		/>
	</div>

	<section id="producten" class="mx-auto max-w-[1400px] scroll-mt-32 px-4 pt-8 sm:px-6 lg:pt-10">
		{alle.length > 0 && (
			<FilterBar pad={pad} params={Astro.url.searchParams} filter={filter} opties={opties} />
		)}

		<div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
			<h1 class="sr-only text-2xl font-bold tracking-tight sm:not-sr-only sm:text-3xl">
				{category.name}
			</h1>
			<p class="text-text-muted">{teller}</p>
		</div>

		{alle.length === 0 ? (
			<div class="mt-6 rounded-card border border-border bg-surface p-8 text-center">
				<p class="font-medium">Er staat nog niets in deze categorie</p>
				<p class="mt-1 text-sm text-text-muted">Kijk gerust in een van de andere categorieën.</p>
				<div class="mt-5 flex justify-center">
					<Button href="/categorieen" variant="secondary">Alle categorieën</Button>
				</div>
			</div>
		) : entries.length === 0 ? (
			<div class="mt-6 rounded-card border border-border bg-surface p-8 text-center">
				<p class="font-medium">Geen producten met deze filters</p>
				<p class="mt-1 text-sm text-text-muted">
					Probeer een andere prijs of maat, of wis de filters.
				</p>
				<div class="mt-5 flex justify-center">
					<Button href={pad} variant="secondary">Filters wissen</Button>
				</div>
			</div>
		) : (
			<ProductGrid items={entries} eagerCount={4} favorieten={favorieten} class="mt-6" />
		)}
	</section>
</Layout>

<script>
	/*
	 * 'Lees meer' onder de categorienaam op telefoon: klapt de afgekapte tekst
	 * uit en terug. De toestand staat op aria-expanded, het afkappen is een
	 * klasse; zo blijft de opmaak in de HTML en doet het script alleen het
	 * omzetten.
	 */
	const tekst = document.querySelector<HTMLElement>('[data-inleiding]');
	const knop = document.querySelector<HTMLButtonElement>('[data-inleiding-knop]');

	// Past de tekst al in twee regels, dan valt er niets uit te klappen en is de
	// knop alleen maar in de weg. Buiten telefoonbreedte staat het blok op
	// display:none en zijn beide hoogtes 0; ook dan blijft de knop weg.
	if (tekst && knop && tekst.scrollHeight <= tekst.clientHeight + 1) knop.hidden = true;

	knop?.addEventListener('click', () => {
		const open = knop.getAttribute('aria-expanded') === 'true';
		knop.setAttribute('aria-expanded', String(!open));
		knop.textContent = open ? 'Lees meer' : 'Lees minder';
		tekst?.classList.toggle('line-clamp-2', open);
	});
</script>
