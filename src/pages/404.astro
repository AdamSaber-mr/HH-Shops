---
import NietGevonden from '../components/NietGevonden.astro';

/*
 * De foutpagina die Astro zelf gebruikt als een pagina met een lege 404
 * antwoordt, bijvoorbeeld de productpagina bij een onbekende slug.
 *
 * Een adres waar helemaal geen route bij past komt hier NIET langs; dat gaat
 * naar [...pad].astro. Zie de toelichting daar, want dat verschil is de reden
 * dat dat bestand bestaat.
 */
Astro.response.headers.set('Cache-Control', 'no-store');
---

<NietGevonden />
