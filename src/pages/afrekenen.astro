---
import { actions } from 'astro:actions';
import { Icon } from 'astro-icon/components';
import Button from '../components/Button.astro';
import Formulierveld from '../components/klant/Formulierveld.astro';
import Melding from '../components/klant/Melding.astro';
import ProductImage from '../components/ProductImage.astro';
import Layout from '../layouts/Layout.astro';
import { leesFormulier, veldfoutenUit } from '../lib/admin/formulier.ts';
import { totalen } from '../lib/bestellen/bedragen.ts';
import { getBetaalkoppeling } from '../lib/bestellen/server.ts';
import { leesAdres } from '../lib/klanten/account.ts';
import { leesFlash } from '../lib/klanten/flash.ts';
import { haalWinkelmand } from '../lib/klanten/winkelmand.ts';
import { formatEuro } from '../lib/price.ts';

/*
 * Afrekenen. Een formulier met gegevens en adres, ernaast de samenvatting.
 * Gasten kunnen afrekenen; een ingelogde klant krijgt naam, e-mail en het
 * bezorgadres vooringevuld. Na het plaatsen gaat de klant naar Mollie.
 *
 * De bedragen hier zijn ter informatie: de action rekent alles opnieuw uit
 * op het moment van plaatsen.
 */

const result = Astro.getActionResult(actions.afrekenen.plaatsen);
if (result && !result.error) return Astro.redirect(result.data.checkoutUrl, 303);

const overzicht = await haalWinkelmand(Astro);
if (overzicht.regels.length === 0 && !result?.error) return Astro.redirect('/winkelmand', 303);

const user = Astro.locals.user;
const adres = user ? await leesAdres(user.id) : undefined;
const { velden: fouten, algemeen } = veldfoutenUit(result?.error);
const ingevuld = result?.error
	? (await leesFormulier(Astro.request)).velden
	: {
			email: user?.email ?? '',
			name: adres?.name ?? user?.name ?? '',
			street: adres?.street ?? '',
			houseNumber: adres?.houseNumber ?? '',
			houseNumberAddition: adres?.houseNumberAddition ?? '',
			postalCode: adres?.postalCode ?? '',
			city: adres?.city ?? '',
		};
const bedragen = totalen(
	overzicht.regels.map((r) => ({ lineTotalCents: r.regelTotaalCents, vatRate: 21 })),
);
const nep = getBetaalkoppeling(Astro.url.origin).modus === 'nep';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Layout title="Afrekenen" noindex>
	<div class="mx-auto max-w-[1400px] px-4 py-6 sm:px-6 lg:py-10">
		<h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Afrekenen</h1>
		<div class="mt-4 space-y-3">
			<Melding melding={leesFlash(Astro.cookies)} class="" />
			<Melding melding={algemeen ? { soort: 'fout', tekst: algemeen } : null} class="" />
			{overzicht.meldingen.map((tekst) => <Melding melding={{ soort: 'fout', tekst }} class="" />)}
		</div>

		<div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_400px]">
			<form method="POST" action={actions.afrekenen.plaatsen} class="space-y-8" novalidate>
				{!user && (
					<p class="rounded-card border border-border bg-surface px-4 py-3 text-sm">
						Heb je een account?
						<a href="/account/inloggen?naar=%2Fafrekenen" class="font-medium text-accent hover:underline">Log in</a>
						en je gegevens staan klaar. Bestellen zonder account kan ook.
					</p>
				)}

				<section aria-labelledby="gegevens-titel" class="rounded-card border border-border bg-surface p-5 sm:p-6">
					<h2 id="gegevens-titel" class="text-lg font-semibold">Je gegevens</h2>
					<div class="mt-4 grid gap-5 sm:grid-cols-2">
						<Formulierveld naam="email" label="E-mailadres" type="email" autocomplete="email" inputmode="email" verplicht hint="Hierop krijg je de bevestiging." waarde={ingevuld.email ?? ''} fout={fouten.email?.[0]} />
						<Formulierveld naam="phone" label="Telefoonnummer" type="tel" autocomplete="tel" hint="Voor de bezorger." waarde={ingevuld.phone ?? ''} fout={fouten.phone?.[0]} />
					</div>
				</section>

				<section aria-labelledby="adres-titel" class="rounded-card border border-border bg-surface p-5 sm:p-6">
					<h2 id="adres-titel" class="text-lg font-semibold">Bezorgadres</h2>
					<p class="mt-1 text-sm text-text-muted">We bezorgen in heel Nederland.</p>
					<div class="mt-4 space-y-5">
						<Formulierveld naam="name" label="Naam van de ontvanger" autocomplete="name" verplicht maxlength={100} waarde={ingevuld.name ?? ''} fout={fouten.name?.[0]} />
						<div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_120px_120px]">
							<Formulierveld naam="street" label="Straat" autocomplete="address-line1" verplicht maxlength={100} waarde={ingevuld.street ?? ''} fout={fouten.street?.[0]} />
							<Formulierveld naam="houseNumber" label="Huisnummer" inputmode="numeric" verplicht maxlength={6} waarde={ingevuld.houseNumber ?? ''} fout={fouten.houseNumber?.[0]} />
							<Formulierveld naam="houseNumberAddition" label="Toevoeging" maxlength={10} waarde={ingevuld.houseNumberAddition ?? ''} fout={fouten.houseNumberAddition?.[0]} />
						</div>
						<div class="grid gap-5 sm:grid-cols-[160px_minmax(0,1fr)]">
							<Formulierveld naam="postalCode" label="Postcode" autocomplete="postal-code" verplicht maxlength={7} waarde={ingevuld.postalCode ?? ''} fout={fouten.postalCode?.[0]} />
							<Formulierveld naam="city" label="Plaats" autocomplete="address-level2" verplicht maxlength={100} waarde={ingevuld.city ?? ''} fout={fouten.city?.[0]} />
						</div>
					</div>
				</section>

				<section aria-labelledby="opmerking-titel" class="rounded-card border border-border bg-surface p-5 sm:p-6">
					<h2 id="opmerking-titel" class="text-lg font-semibold">Opmerking</h2>
					<label for="veld-customerNote" class="mt-4 block text-sm font-medium">
						Iets wat we moeten weten? <span class="font-normal text-text-muted">(niet verplicht)</span>
					</label>
					<textarea id="veld-customerNote" name="customerNote" rows="3" maxlength="500" aria-invalid={fouten.customerNote ? 'true' : undefined} class:list={['mt-1.5 block w-full rounded-control border bg-surface px-3 py-2 text-base', fouten.customerNote ? 'border-danger' : 'border-border-strong']}>{ingevuld.customerNote ?? ''}</textarea>
					{fouten.customerNote && <p class="mt-1 text-sm text-danger">{fouten.customerNote[0]}</p>}
				</section>

				<section class="rounded-card border border-border bg-surface p-5 sm:p-6">
					<div class="flex items-start gap-3">
						<input id="veld-voorwaarden" name="voorwaarden" type="checkbox" value="ja" checked={ingevuld.voorwaarden === 'ja'} class="mt-1 size-5 shrink-0 rounded border-border-strong accent-accent" aria-invalid={fouten.voorwaarden ? 'true' : undefined} aria-describedby={fouten.voorwaarden ? 'voorwaarden-fout' : undefined} />
						<label for="veld-voorwaarden" class="text-sm">
							Ik ga akkoord met de <a href="/algemene-voorwaarden" class="font-medium text-accent hover:underline">algemene voorwaarden</a> en weet dat ik 14 dagen bedenktijd heb.
						</label>
					</div>
					{fouten.voorwaarden && <p id="voorwaarden-fout" class="mt-2 text-sm text-danger">{fouten.voorwaarden[0]}</p>}
					<div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
						<label for="veld-website">Website, laat dit veld leeg</label>
						<input id="veld-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>
					<Button type="submit" block size="lg" class="mt-5">
						Bestellen en betalen
						<Icon name="ph:arrow-right" class="size-5" aria-hidden="true" />
					</Button>
					<p class="mt-3 text-center text-xs text-text-muted">
						{nep ? 'Testomgeving: je kiest straks zelf hoe de betaling afloopt.' : 'Je betaalt veilig via Mollie met iDEAL of creditcard.'}
					</p>
				</section>
			</form>

			<aside class="h-fit rounded-card border border-border bg-surface p-5 sm:p-6 lg:sticky lg:top-24" aria-labelledby="samenvatting-titel">
				<h2 id="samenvatting-titel" class="text-lg font-semibold">Je bestelling</h2>
				<ul class="mt-4 divide-y divide-border">
					{overzicht.regels.map((regel) => (
						<li class="flex gap-3 py-3">
							<div class="size-14 shrink-0 overflow-hidden rounded-control bg-surface-hover">
								{regel.image && <ProductImage src={regel.image.url} alt="" width={regel.image.width} height={regel.image.height} widths={[112]} sizes="56px" class="size-full object-cover" />}
							</div>
							<div class="min-w-0 flex-1 text-sm">
								<p class="font-medium">{regel.product.name}</p>
								<p class="text-text-muted">{regel.aantal} x {formatEuro(regel.priceCents)}{regel.optieTekst ? `, ${regel.optieTekst}` : ''}</p>
							</div>
							<p class="text-sm font-medium tabular-nums">{formatEuro(regel.regelTotaalCents)}</p>
						</li>
					))}
				</ul>
				<dl class="mt-4 space-y-2 border-t border-border pt-4 text-sm">
					<div class="flex justify-between gap-4"><dt>Subtotaal</dt><dd class="tabular-nums">{formatEuro(bedragen.subtotaalCents)}</dd></div>
					<div class="flex justify-between gap-4"><dt>Verzendkosten</dt><dd class="tabular-nums">{bedragen.verzendCents === 0 ? 'Gratis' : formatEuro(bedragen.verzendCents)}</dd></div>
					<div class="flex justify-between gap-4 border-t border-border pt-2 text-base font-semibold"><dt>Totaal</dt><dd class="tabular-nums">{formatEuro(bedragen.totaalCents)}</dd></div>
					<div class="flex justify-between gap-4 text-xs text-text-muted"><dt>Waarvan btw</dt><dd class="tabular-nums">{formatEuro(bedragen.btwCents)}</dd></div>
				</dl>
				<a href="/winkelmand" class="mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent hover:underline">
					<Icon name="ph:arrow-left" class="size-4" aria-hidden="true" />
					Winkelmand aanpassen
				</a>
			</aside>
		</div>
	</div>
</Layout>
