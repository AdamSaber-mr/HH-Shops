---
import { actions } from 'astro:actions';
import Veld from '../../components/admin/Veld.astro';
import Button from '../../components/Button.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { veldfoutenUit } from '../../lib/admin/formulier.ts';

/*
 * Wachtwoord vergeten voor beheerders. Zelfde mechanisme als bij klanten;
 * de link in de mail wijst naar /admin/wachtwoord-herstellen.
 */

const result = Astro.getActionResult(actions.auth.wachtwoordVergeten);
const verstuurd = Boolean(result && !result.error);
const { velden: fouten, algemeen } = veldfoutenUit(result?.error);
const ingevuld = result?.error ? await Astro.request.clone().formData().catch(() => null) : null;
const email = typeof ingevuld?.get('email') === 'string' ? String(ingevuld.get('email')) : '';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AdminLayout title="Wachtwoord vergeten" variant="kaal">
	<div class="rounded-card border border-border bg-surface p-6 sm:p-8">
		<h1 class="text-xl font-semibold">Wachtwoord vergeten</h1>
		<p class="mt-1 text-sm text-text-muted">
			Vul het e-mailadres van je beheerdersaccount in. Je krijgt een mail met een link om een nieuw
			wachtwoord te kiezen.
		</p>

		{
			verstuurd ? (
				<p role="status" class="mt-5 rounded-control border border-accent/30 bg-accent-subtle px-3 py-2 text-sm">
					Als dit adres bij ons bekend is, hebben we een mail gestuurd. De link is een uur geldig.
				</p>
			) : (
				<>
					{algemeen && (
						<p role="alert" class="mt-5 rounded-control border border-danger/30 bg-danger-subtle px-3 py-2 text-sm text-danger">
							{algemeen}
						</p>
					)}
					<form method="POST" action={actions.auth.wachtwoordVergeten} class="mt-6 space-y-5" novalidate>
						<Veld naam="email" label="E-mailadres" type="email" autocomplete="username" verplicht waarde={email} fout={fouten.email} />
						<Button type="submit" block>
							Stuur de mail
						</Button>
					</form>
				</>
			)
		}
	</div>
	<p class="mt-6 text-center text-sm text-text-muted">
		<a href="/admin/inloggen" class="text-accent underline-offset-2 hover:underline">Terug naar inloggen</a>
	</p>
</AdminLayout>
