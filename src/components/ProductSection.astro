---
import { Icon } from 'astro-icon/components';
import ProductGrid, { type ProductEntry } from './ProductGrid.astro';

/*
 * Een productrij op de startpagina: kop, link rechts en het raster uit
 * ProductGrid. "Populaire producten" en "Nieuw binnen" zijn allebei dit
 * component met andere producten erin.
 */

interface Props {
	id: string;
	title: string;
	link?: { label: string; href: string };
	items: readonly ProductEntry[];
	/** De eerste kaarten boven de vouw laden eager. */
	eagerCount?: number;
	favorieten?: ReadonlySet<number>;
	/** `balk`: op telefoon en tablet veeg je door de rij. */
	vorm?: 'raster' | 'balk';
}

const { id, title, link, items, eagerCount = 0, favorieten, vorm = 'raster' } = Astro.props;
---

<section class="mx-auto max-w-[1400px] px-4 sm:px-6" aria-labelledby={`${id}-titel`}>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h2 id={`${id}-titel`} class="text-2xl font-bold tracking-tight sm:text-3xl">{title}</h2>
		{link && (
			<a
				href={link.href}
				class="inline-flex min-h-11 items-center gap-1.5 rounded-control text-sm font-medium text-accent hover:underline"
			>
				{link.label}
				<Icon name="ph:caret-right" class="size-4" aria-hidden="true" />
			</a>
		)}
	</div>

	{items.length === 0 ? (
		<div class="mt-6 rounded-card border border-border bg-surface p-8 text-center">
			<p class="font-medium">Er staat nog niets in de winkel</p>
			<p class="mt-1 text-sm text-text-muted">
				Zodra het assortiment is overgezet, staan de producten hier.
			</p>
		</div>
	) : (
		<ProductGrid
			items={items}
			eagerCount={eagerCount}
			favorieten={favorieten}
			vorm={vorm}
			class="mt-6"
		/>
	)}
</section>
