---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logo from '../assets/logo.png';
import { categoryHref } from '../lib/navigation.ts';
import { footerGroups, paymentMethods, site } from '../lib/site.ts';

/*
 * De footer van elke pagina.
 *
 * Bovenin een nieuwsbriefstrook, daaronder vier kolommen (over de winkel,
 * categorieen, klantenservice, over H&H Shops) en een onderbalk met
 * betaalmethoden en de juridische regel.
 *
 * Op telefoon stonden die vier kolommen onder elkaar en was de voet bijna een
 * heel scherm lang. Nu ligt het anders neer, zonder dat er iets verdwijnt:
 *
 *  - het merkblok en de categorieen nemen de volle breedte;
 *  - de categorieen staan daarbinnen in twee kolommen naast elkaar;
 *  - klantenservice en "over H&H Shops" staan naast elkaar, allebei vijf
 *    regels, dus er blijft geen gat over.
 *
 * Dat laatste is de reden dat de categorieen apart staan: in een raster is
 * elke rij zo hoog als zijn langste kolom, en met negen categorieen naast een
 * lijstje van vijf krijg je een half scherm wit.
 *
 * Het nieuwsbriefformulier verstuurt nog nergens heen. De action wijst naar
 * /nieuwsbrief, die pagina komt als de e-mailprovider gekozen is.
 *
 * Contactgegevens komen uit src/lib/site.ts en zijn deels nog INVULLEN. De
 * categorieen komen via Layout uit de database.
 */

interface Props {
	categorieen: readonly { slug: string; name: string }[];
}

const { categorieen } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface lg:mt-24">
	<!-- Nieuwsbrief -->
	<div class="border-b border-border">
		<div
			class="mx-auto flex max-w-[1400px] flex-col gap-4 px-4 py-8 sm:gap-6 sm:px-6 sm:py-10 lg:flex-row lg:items-center lg:justify-between"
		>
			<div class="max-w-md">
				<h2 class="text-xl font-bold tracking-tight">Blijf op de hoogte</h2>
				<p class="mt-1 text-sm text-pretty text-text-muted">
					Nieuwe producten en acties als eerste in je inbox. Geen spam, uitschrijven kan altijd.
				</p>
			</div>
			<form action="/nieuwsbrief" method="post" class="flex w-full max-w-lg gap-2">
				<label for="nieuwsbrief-email" class="sr-only">E-mailadres</label>
				<input
					id="nieuwsbrief-email"
					type="email"
					name="email"
					required
					autocomplete="email"
					placeholder="Je e-mailadres"
					class="min-h-12 min-w-0 flex-1 rounded-control border border-border-strong bg-surface px-4 text-sm placeholder:text-text-muted focus:border-accent"
				/>
				<button
					type="submit"
					class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-control bg-accent px-5 text-sm font-medium text-white transition-colors hover:bg-accent-hover"
				>
					Aanmelden
				</button>
			</form>
		</div>
	</div>

	<!-- Kolommen -->
	<div
		class="mx-auto grid max-w-[1400px] grid-cols-2 gap-x-6 gap-y-8 px-4 py-10 sm:px-6 sm:py-12 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-8 lg:py-12"
	>
		<div class="col-span-2 lg:col-span-1">
			<a href="/" class="inline-block rounded-control" aria-label="H&H Shops, naar de startpagina">
				<Image
					src={logo}
					alt=""
					widths={[160, 320]}
					sizes="158px"
					loading="lazy"
					class="h-9 w-auto"
				/>
			</a>
			<p class="mt-3 max-w-xs text-sm text-pretty text-text-muted">{site.description}</p>
			<ul class="mt-4 space-y-2 text-sm lg:mt-5">
				<li class="flex items-center gap-2">
					<Icon name="ph:envelope-simple" class="size-4 shrink-0 text-accent" aria-hidden="true" />
					<a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a>
				</li>
				<li class="flex items-center gap-2">
					<Icon name="ph:map-pin" class="size-4 shrink-0 text-accent" aria-hidden="true" />
					<span>Nederland</span>
				</li>
			</ul>
		</div>

		<nav class="col-span-2 lg:col-span-1" aria-labelledby="footer-categorieen">
			<h2 id="footer-categorieen" class="text-sm font-semibold tracking-wide uppercase">
				Categorieën
			</h2>
			<ul
				class="mt-3 grid grid-cols-2 gap-x-6 gap-y-2 text-sm lg:mt-4 lg:block lg:space-y-2.5"
			>
				{categorieen.map((category) => (
					<li>
						<a href={categoryHref(category.slug)} class="text-text-muted hover:text-accent hover:underline">
							{category.name}
						</a>
					</li>
				))}
			</ul>
		</nav>

		{footerGroups.map((group, index) => (
			<nav aria-labelledby={`footer-groep-${index}`}>
				<h2 id={`footer-groep-${index}`} class="text-sm font-semibold tracking-wide uppercase">
					{group.title}
				</h2>
				<ul class="mt-3 space-y-2 text-sm lg:mt-4 lg:space-y-2.5">
					{group.links.map((link) => (
						<li>
							<a href={link.href} class="text-text-muted hover:text-accent hover:underline">
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		))}
	</div>

	<!-- Onderbalk -->
	<div class="border-t border-border">
		<div
			class="mx-auto flex max-w-[1400px] flex-col gap-3 px-4 py-5 text-xs text-text-muted sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6 sm:py-6"
		>
			<p>
				© {year} {site.name}. Alle rechten voorbehouden.
				{site.kvk && <span> · KVK {site.kvk}</span>}
				{site.btw && <span> · btw {site.btw}</span>}
			</p>
			<ul class="flex flex-wrap gap-1.5 sm:gap-2" aria-label="Betaalmethoden">
				{paymentMethods.map((method) => (
					<li class="rounded-control border border-border bg-canvas px-2.5 py-1 font-medium text-text">
						{method}
					</li>
				))}
			</ul>
		</div>
	</div>
</footer>
