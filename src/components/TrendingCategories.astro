---
import { Icon } from 'astro-icon/components';
import { listCategories } from '../lib/catalog.ts';
import { categoryHref } from '../lib/navigation.ts';
import CategoryCard from './CategoryCard.astro';

/*
 * "Populaire categorieen" op de startpagina: een grote kaart links en vier
 * kleinere in een blok van twee bij twee rechts. De vier kleine zijn even
 * breed als de productkaarten eronder; de grote is twee kaarten plus de
 * tussenruimte, en daarmee precies even hoog als het blok ernaast.
 *
 * Welke vijf: de categorieen uit de database op volgorde van `position`
 * (in te stellen in het beheerpaneel), maar alleen die met een foto in
 * src/assets/categorieen/<slug>.png. De eerste wordt de grote kaart. Zo kan
 * Adam de volgorde en de selectie sturen zonder code: een categorie zonder
 * foto staat er niet bij, en de eerste met foto is de blikvanger.
 *
 * Zes op een rij bleek te klein (zo'n 215px per kaart) en drie per rij te
 * groot (zo'n 435px). Dit is de tussenweg die Adam koos: vijf kaarten, een
 * eruit springend. De sectie is even breed als de productrijen (1400
 * pixels), zodat de kaarten uitlijnen met de producten eronder. De kaarten
 * zijn 5:4 en de foto's ook, zie CategoryCard. Het blok is zo'n 535px hoog.
 *
 * Op telefoon en tablet staat de grote kaart over de volle breedte bovenaan
 * en het blok van vier eronder.
 */

const AANTAL = 5;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/categorieen/*.png', {
	eager: true,
});

const kaarten = (await listCategories())
	.map((c) => ({ ...c, image: files[`../assets/categorieen/${c.slug}.png`]?.default }))
	.filter((c): c is typeof c & { image: ImageMetadata } => c.image !== undefined)
	.slice(0, AANTAL);

const [featured, ...rest] = kaarten;
---

<section
	class="mx-auto max-w-[1400px] px-4 pt-12 sm:px-6 lg:pt-16"
	aria-labelledby="trending-titel"
>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h2 id="trending-titel" class="text-2xl font-bold tracking-tight sm:text-3xl">
			Populaire categorieën
		</h2>
		<a
			href="/categorieen"
			class="inline-flex min-h-11 items-center gap-1.5 rounded-control text-sm font-medium text-accent hover:underline"
		>
			Alle categorieën
			<Icon name="ph:caret-right" class="size-4" aria-hidden="true" />
		</a>
	</div>

	{featured ? (
		<div class="mt-6 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
			<CategoryCard
				name={featured.name}
				href={categoryHref(featured.slug)}
				image={featured.image}
				featured
			/>
			{rest.map((category) => (
				<CategoryCard
					name={category.name}
					href={categoryHref(category.slug)}
					image={category.image}
				/>
			))}
		</div>
	) : (
		<p class="mt-6 text-text-muted">Er zijn nog geen categorieën met een foto.</p>
	)}
</section>
