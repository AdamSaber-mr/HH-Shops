---
import { Icon } from 'astro-icon/components';
import { categoryHref, trendingCategories } from '../lib/navigation.ts';
import CategoryCard from './CategoryCard.astro';

/*
 * "Trending categorieen" op de startpagina: zes vierkante foto's, drie per
 * rij op desktop en twee op telefoon. Drie per rij en niet zes, zodat de
 * kaarten (zo'n 435px) groter zijn dan de productkaarten (zo'n 320px): de
 * categorieen zijn de hoofdingang van de winkel. Welke zes staat in
 * src/lib/navigation.ts; de foto's staan in src/assets/categorieen, een per
 * slug.
 *
 * De glob koppelt slug aan bestand. Ontbreekt een foto, dan valt de build om
 * met een duidelijke fout in plaats van een lege kaart op de site.
 */

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/categorieen/*.png', {
	eager: true,
});

function imageFor(slug: string): ImageMetadata {
	const entry = files[`../assets/categorieen/${slug}.png`];
	if (!entry) throw new Error(`Geen categoriefoto voor "${slug}" in src/assets/categorieen`);
	return entry.default;
}
---

<section
	class="mx-auto max-w-[1400px] px-4 py-14 sm:px-6 lg:py-20"
	aria-labelledby="trending-titel"
>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h2 id="trending-titel" class="text-2xl font-bold tracking-tight sm:text-3xl">
			Trending categorieën
		</h2>
		<a
			href="/categorieen"
			class="inline-flex min-h-11 items-center gap-1.5 rounded-control text-sm font-medium text-accent hover:underline"
		>
			Alle categorieën
			<Icon name="ph:caret-right" class="size-4" aria-hidden="true" />
		</a>
	</div>

	<div class="mt-6 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3">
		{trendingCategories.map((category) => (
			<CategoryCard
				name={category.name}
				href={categoryHref(category.slug)}
				image={imageFor(category.slug)}
			/>
		))}
	</div>
</section>
