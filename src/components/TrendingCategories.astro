---
import { Icon } from 'astro-icon/components';
import { categoryHref, trendingCategories } from '../lib/navigation.ts';
import CategoryCard from './CategoryCard.astro';

/*
 * "Trending categorieen" op de startpagina: een grote kaart links en vier
 * kleinere in een blok van twee bij twee rechts. De vier kleine zijn even
 * breed als de productkaarten eronder; de grote is twee kaarten plus de
 * tussenruimte, en daarmee precies even hoog als het blok ernaast.
 *
 * Zes op een rij bleek te klein (zo'n 215px per kaart) en drie per rij te
 * groot (zo'n 435px). Dit is de tussenweg die Adam koos: vijf kaarten, een
 * eruit springend. Welke vijf, en welke de grote is, staat in
 * src/lib/navigation.ts; de foto's staan in src/assets/categorieen, een per
 * slug.
 *
 * De sectie is smaller dan de rest van de pagina (1100 in plaats van 1400
 * pixels): op volle breedte vond Adam de grote kaart te groot. De kleine
 * kaarten zijn nu zo'n 245px, de grote zo'n 515px.
 *
 * Op telefoon en tablet staat de grote kaart over de volle breedte bovenaan
 * en het blok van vier eronder.
 *
 * De glob koppelt slug aan bestand. Ontbreekt een foto, dan valt de build om
 * met een duidelijke fout in plaats van een lege kaart op de site.
 */

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/categorieen/*.png', {
	eager: true,
});

function imageFor(slug: string): ImageMetadata {
	const entry = files[`../assets/categorieen/${slug}.png`];
	if (!entry) throw new Error(`Geen categoriefoto voor "${slug}" in src/assets/categorieen`);
	return entry.default;
}

const [featured, ...rest] = trendingCategories;
if (!featured) throw new Error('trendingCategories is leeg');
---

<!-- Bewust smaller dan de rest van de pagina (1100 in plaats van 1400 pixels):
     op volle breedte werd de grote kaart te groot. -->
<section
	class="mx-auto max-w-[1100px] px-4 py-14 sm:px-6 lg:py-20"
	aria-labelledby="trending-titel"
>
	<div class="flex flex-wrap items-end justify-between gap-4">
		<h2 id="trending-titel" class="text-2xl font-bold tracking-tight sm:text-3xl">
			Trending categorieën
		</h2>
		<a
			href="/categorieen"
			class="inline-flex min-h-11 items-center gap-1.5 rounded-control text-sm font-medium text-accent hover:underline"
		>
			Alle categorieën
			<Icon name="ph:caret-right" class="size-4" aria-hidden="true" />
		</a>
	</div>

	<div class="mt-6 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
		<CategoryCard
			name={featured.name}
			href={categoryHref(featured.slug)}
			image={imageFor(featured.slug)}
			featured
		/>
		{rest.map((category) => (
			<CategoryCard
				name={category.name}
				href={categoryHref(category.slug)}
				image={imageFor(category.slug)}
			/>
		))}
	</div>
</section>
