---
import { Image } from 'astro:assets';
import banner from '../assets/hero-banner.png';
import Button from './Button.astro';

/*
 * De hero bovenaan de startpagina.
 *
 * De banner is de achtergrond van de hele sectie, op elk formaat. De tekst
 * ligt erover. Er is bewust geen tweede, losse afbeelding onder de tekst meer:
 * dat gaf op telefoon een zichtbare naad tussen een blauw tekstvlak en een
 * plaatje, en dat zag eruit als twee blokken in plaats van een banner.
 *
 * Om de tekst leesbaar te houden ligt er een verloop over de banner, in de
 * kleur van de banner zelf (--color-sky, gemeten op de linkerrand):
 *
 *  - telefoon en tablet: van boven naar beneden. Bovenin dekkend, zodat de
 *    kop en de knoppen op een rustig vlak staan; onderin doorzichtig, zodat de
 *    gele podia met de producten er gewoon onder vandaan komen.
 *  - desktop: van links naar rechts over de linkerhelft. Daar is de banner
 *    toch al leeg, en rechts blijven de producten onaangeroerd.
 *
 * Op desktop is de sectie de helft van de vensterbreedte hoog (de banner is
 * 2:1), met een plafond van 44rem. Zo wordt er bij 1440px vrijwel niets
 * weggesneden.
 *
 * LET OP: dit is bewust een hoogte en geen `aspect-ratio` met een `max-h`.
 * Bij die combinatie rekent de browser de breedte terug uit de geknipte
 * hoogte, en dan is de sectie op een 1920px-scherm nog maar 1408px breed
 * met een witte strook rechts.
 *
 * Op telefoon wordt er bovendien ingezoomd (scale 1,4). Zonder die zoom snijdt
 * object-cover een staande strook uit een liggende banner, en dan is de
 * onderste kwart van de hero kale vloer en de bovenste kwart kale lucht. Met
 * de zoom staan de gele podia met de producten vol in beeld.
 *
 * De banner is de grootste afbeelding van de pagina en bepaalt de LCP.
 * Daarom: fetchpriority="high" en geen lazy loading. Het is nu ook nog maar
 * een afbeelding in plaats van twee, dus een telefoon haalt niet langer een
 * bureaubladversie op die hij toch niet laat zien.
 */

interface Props {
	title: string;
	text: string;
	primary: { label: string; href: string };
	secondary?: { label: string; href: string };
}

const { title, text, primary, secondary } = Astro.props;
---

<section
	class="relative isolate overflow-hidden bg-sky lg:h-[min(50vw,44rem)]"
	aria-labelledby="hero-titel"
>
	<div class="absolute inset-0" aria-hidden="true">
		<Image
			src={banner}
			alt=""
			widths={[480, 768, 1024, 1440, 1774]}
			sizes="100vw"
			quality={75}
			loading="eager"
			fetchpriority="high"
			decoding="async"
			class="size-full origin-[50%_42%] scale-[1.4] object-cover object-[72%_center] lg:origin-center lg:scale-100 lg:object-[right_40%]"
		/>
		<div
			class="absolute inset-0 bg-gradient-to-b from-sky from-30% via-sky/85 via-60% to-transparent lg:hidden"
		>
		</div>
		<div
			class="absolute inset-y-0 left-0 hidden w-1/2 bg-gradient-to-r from-sky via-sky/60 to-transparent lg:block"
		>
		</div>
	</div>

	<div class="relative mx-auto flex h-full max-w-[1400px] px-4 sm:px-6">
		<div
			class="flex min-h-[30rem] flex-col justify-start pt-10 pb-16 sm:min-h-[34rem] sm:pt-14 lg:min-h-0 lg:max-w-xl lg:justify-center lg:py-24"
		>
			<p class="text-sm font-semibold tracking-wide text-accent uppercase">H&amp;H Shops</p>
			<h1
				id="hero-titel"
				class="mt-3 text-4xl font-bold tracking-tight text-balance text-accent-hover sm:text-5xl lg:text-6xl"
			>
				{title}
			</h1>
			<p class="mt-5 max-w-md text-base text-pretty text-text sm:text-lg">{text}</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<Button href={primary.href} size="lg">{primary.label}</Button>
				{secondary && (
					<Button href={secondary.href} size="lg" variant="secondary">
						{secondary.label}
					</Button>
				)}
			</div>
		</div>
	</div>
</section>
