---
import { Icon } from 'astro-icon/components';
import { ratingSource, reviews } from '../lib/reviews.ts';
import RecensieKaart from './RecensieKaart.astro';

/*
 * Het vertrouwensblok: de score als grote, gecentreerde kop, daaronder de
 * recensies als kaarten op de lichte achtergrond.
 *
 * Bewust geen achtergrondtint en geen lijnen: Adam heeft een groene band, een
 * lichte tint en scheidingslijnen allemaal bekeken en vond de kale pagina het
 * mooist. De tussenbanner erboven is al groen; dat is het enige gekleurde
 * blok. De ruimte erboven is dezelfde als bij elke sectie (pt-12 lg:pt-16).
 *
 * De recensies staan op desktop op vier kolommen, hetzelfde raster als de
 * productrijen. De teksten zijn kort, op twee kolommen werden de kaarten leeg.
 *
 * Op telefoon en tablet schuiven ze in plaats daarvan onafgebroken naar links
 * langs het scherm. Vier kaarten onder elkaar duwen de rest van de pagina ver
 * weg, en dan leest niemand ze; in een lopende balk komen ze alle vier vanzelf
 * voorbij. De reeks staat er twee keer, zodat de sprong terug naar het begin
 * niet te zien is; de tweede reeks is `aria-hidden`, anders zou een
 * schermlezer elke recensie dubbel voorlezen.
 *
 * De balk staat stil zodra je hem aanraakt of er met de muis op staat, en
 * beweegt helemaal niet voor wie in zijn toestel heeft gezegd geen animaties
 * te willen (`motion-safe`). In beide gevallen kun je er gewoon doorheen
 * vegen.
 *
 * De inhoud komt uit src/lib/reviews.ts: echte recensies van de oude site,
 * met bol.com als bron. Het blok werkt met elke bron en elke schaal (10 op
 * bol.com, 5 op Google), zodat een overstap naar Google-reviews later alleen
 * een datawijziging is.
 *
 * Sterren zijn nooit de enige drager van de score: de score staat er ook als
 * getal, en elke recensie heeft een sr-only regel met het aantal sterren.
 */

const stars = [1, 2, 3, 4, 5] as const;
const scoreLabel = ratingSource.score.toLocaleString('nl-NL', {
	minimumFractionDigits: 1,
	maximumFractionDigits: 1,
});
// Voor de sterren onder de kop: de score omgerekend naar een schaal van 5.
const scoreStars = Math.round((ratingSource.score / ratingSource.max) * 5);
---

<section aria-labelledby="reviews-titel">
	<div class="mx-auto max-w-[1400px] px-4 pt-12 sm:px-6 lg:pt-16">
	<div class="mx-auto max-w-2xl text-center">
		<p class="text-sm font-semibold tracking-wide text-accent uppercase">Wat onze klanten zeggen</p>
		<h2 id="reviews-titel" class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
			Klanten geven ons een{' '}
			<span class="text-accent">{scoreLabel}</span>
		</h2>
		<div class="mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
			<div class="flex gap-1 text-star" aria-hidden="true">
				{stars.map((n) => (
					<Icon name="ph:star-fill" class={`size-6 ${n <= scoreStars ? '' : 'opacity-25'}`} />
				))}
			</div>
			<p class="text-text-muted">
				<span class="sr-only">{scoreLabel} van de {ratingSource.max}, </span>
				gemiddelde beoordeling van klanten op{' '}
				<span class="font-semibold text-text">{ratingSource.name}</span>
			</p>
		</div>
		{ratingSource.url && (
			<a
				href={ratingSource.url}
				rel="noopener"
				target="_blank"
				class="mt-3 inline-flex min-h-11 items-center gap-1.5 rounded-control text-sm font-medium text-accent hover:underline"
			>
				Bekijk alle reviews op {ratingSource.name}
				<Icon name="ph:arrow-right" class="size-4" aria-hidden="true" />
				<span class="sr-only">(opent in een nieuw venster)</span>
			</a>
		)}
	</div>

	<!-- Op telefoon een lopende balk, op desktop een raster van vier. -->
	<div
		class="mt-10 max-lg:-mx-4 max-lg:overflow-x-auto max-lg:geen-schuifbalk sm:max-lg:-mx-6"
	>
		<div
			class="max-lg:flex max-lg:w-max max-lg:hover:[animation-play-state:paused] max-lg:motion-safe:animate-recensies"
		>
			<ul class="grid grid-cols-4 gap-6 max-lg:flex max-lg:gap-4 max-lg:pr-4" aria-label="Recensies">
				{reviews.map((review) => <RecensieKaart review={review} />)}
			</ul>
			<ul class="hidden max-lg:flex max-lg:gap-4 max-lg:pr-4" aria-hidden="true">
				{reviews.map((review) => <RecensieKaart review={review} />)}
			</ul>
		</div>
	</div>
	</div>
</section>
