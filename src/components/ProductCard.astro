---
import { Icon } from 'astro-icon/components';
import Price from './Price.astro';
import ProductImage from './ProductImage.astro';

/*
 * De productkaart, in de stijl van het voorbeeld van Adam: een licht fotovlak
 * met een hartje in de hoek, daaronder de naam met de prijs ernaast, een regel
 * met de keuzes en de voorraad, en een knop "In winkelmand".
 *
 * Geen kader om de kaart heen; het fotovlak is het kader. Op hover komt de
 * knop groen op, verder beweegt er niets.
 *
 * De hele kaart is klikbaar via een uitgerekt anker over de titel. Het hartje
 * en de knop liggen daar met z-10 bovenop, anders opent een klik op de knop de
 * productpagina in plaats van dat hij iets in de winkelmand doet.
 *
 * Het hartje en de knop doen nu nog niets: verlanglijst en winkelmand komen
 * later. Ze staan er al zodat de kaart zijn definitieve vorm heeft.
 *
 * Geen sterren. Het voorbeeld heeft een beoordeling met een aantal, maar er
 * zijn nog geen recensies, en verzonnen sterren zijn in een winkel geen
 * afwerking maar misleiding. Zodra er recensies zijn, komt die regel erbij.
 */

interface Props {
	slug: string;
	name: string;
	image: { url: string; alt: string; width: number; height: number };
	priceCents: number;
	compareAtPriceCents?: number | null;
	stockQuantity: number;
	/** Bijvoorbeeld "4 maten". Leeg bij een product zonder keuzes. */
	optionSummary?: string;
	/** Eager voor de eerste kaarten boven de vouw. */
	loading?: 'lazy' | 'eager';
}

const {
	slug,
	name,
	image,
	priceCents,
	compareAtPriceCents,
	stockQuantity,
	optionSummary,
	loading = 'lazy',
} = Astro.props;

const soldOut = stockQuantity <= 0;
const lowStock = !soldOut && stockQuantity <= 10;
const stockLabel = soldOut
	? 'Uitverkocht'
	: lowStock
		? `Nog ${stockQuantity} op voorraad`
		: 'Op voorraad';
---

<article class="group relative flex flex-col">
	<div class="relative aspect-square overflow-hidden rounded-card bg-surface-hover">
		<ProductImage
			src={image.url}
			alt={image.alt}
			width={image.width}
			height={image.height}
			widths={[320, 480, 640]}
			sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 50vw"
			loading={loading}
			class={`size-full object-cover mix-blend-multiply transition-transform duration-500 group-hover:scale-[1.03] ${soldOut ? 'opacity-50' : ''}`}
		/>

		<button
			type="button"
			class="absolute top-3 right-3 z-10 inline-flex size-10 items-center justify-center rounded-full bg-surface text-text shadow-sm transition-colors hover:text-danger"
			aria-label={`${name} bewaren`}
			aria-pressed="false"
		>
			<Icon name="ph:heart" class="size-5" aria-hidden="true" />
		</button>

		{soldOut && (
			<span
				class="absolute bottom-3 left-3 rounded-control bg-surface px-2 py-1 text-xs font-medium text-danger shadow-sm"
			>
				Uitverkocht
			</span>
		)}
	</div>

	<div class="flex flex-1 flex-col gap-1 pt-3">
		<div class="flex items-start justify-between gap-3">
			<h3 class="text-sm leading-snug font-semibold">
				<!-- Het uitgerekte anker maakt de hele kaart klikbaar. -->
				<a href={`/product/${slug}`} class="after:absolute after:inset-0 after:rounded-card">
					{name}
				</a>
			</h3>
			<Price cents={priceCents} compareAtCents={compareAtPriceCents} class="shrink-0" />
		</div>

		<p class="text-xs text-text-muted">
			{optionSummary && <span>{optionSummary}<span aria-hidden="true"> · </span></span>}
			<span class={soldOut ? 'text-danger' : 'text-accent'}>{stockLabel}</span>
		</p>

		<div class="mt-auto pt-3">
			{soldOut ? (
				<button
					type="button"
					disabled
					class="relative z-10 inline-flex min-h-10 cursor-not-allowed items-center justify-center rounded-full border border-border bg-surface px-4 text-sm font-medium text-text-disabled"
				>
					Uitverkocht
				</button>
			) : (
				<button
					type="button"
					class="relative z-10 inline-flex min-h-10 items-center justify-center gap-2 rounded-full border border-border-strong bg-surface px-4 text-sm font-medium text-text transition-colors group-hover:border-accent group-hover:bg-accent group-hover:text-white hover:bg-accent-hover"
				>
					In winkelmand
					<span class="sr-only">: {name}</span>
				</button>
			)}
		</div>
	</div>
</article>
