---
import { Icon } from 'astro-icon/components';
import type { Flash } from '../../lib/admin/flash.ts';

/*
 * De melding na een redirect: "Product opgeslagen", "Ingelogd". Een keer
 * getoond, daarna weg. role="status" zodat een schermlezer hem voorleest
 * zonder de focus te stelen.
 */

interface Props {
	flash: Flash | null;
}

const { flash } = Astro.props;
---

{
	flash && (
		<div
			role="status"
			class:list={[
				'mb-6 flex items-start gap-3 rounded-card border px-4 py-3 text-sm',
				flash.soort === 'ok'
					? 'border-accent/30 bg-accent-subtle text-text'
					: 'border-danger/30 bg-danger-subtle text-danger',
			]}
		>
			<Icon
				name={flash.soort === 'ok' ? 'ph:check' : 'ph:warning-circle'}
				class="mt-0.5 size-4 shrink-0"
				aria-hidden="true"
			/>
			<p>{flash.tekst}</p>
		</div>
	)
}
