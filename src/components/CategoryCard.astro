---
import { Image } from 'astro:assets';

/*
 * Een categoriekaart voor "Trending categorieen".
 *
 * De foto's van Adam zijn vierkant en hebben de naam van de categorie al in
 * beeld. De kaart is daarom ook vierkant en toont de foto in zijn geheel,
 * zonder eigen titel erover.
 *
 * Omdat de naam alleen in de pixels staat, krijgt de link een sr-only tekst
 * met de naam. Anders is het voor een schermlezer een link zonder naam.
 *
 * De foto komt uit src/assets en gaat via astro:assets, zodat de 1,7 MB grote
 * PNG als kleine WebP bij de bezoeker aankomt.
 */

interface Props {
	name: string;
	href: string;
	image: ImageMetadata;
}

const { name, href, image } = Astro.props;
---

<a
	href={href}
	class="group relative block aspect-square overflow-hidden rounded-card bg-surface-hover shadow-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg"
>
	<Image
		src={image}
		alt=""
		widths={[320, 480, 640, 900]}
		sizes="(min-width: 1400px) 320px, (min-width: 1024px) 23vw, 50vw"
		quality={72}
		loading="lazy"
		decoding="async"
		class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
	/>
	<span class="sr-only">{name}</span>
</a>
