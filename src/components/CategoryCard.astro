---
import { Image } from 'astro:assets';

/*
 * Een categoriekaart voor "Trending categorieen".
 *
 * De foto's van Adam zijn vierkant en hebben de naam van de categorie al in
 * beeld. De kaart is daarom ook vierkant en toont de foto in zijn geheel,
 * zonder eigen titel erover.
 *
 * Omdat de naam alleen in de pixels staat, krijgt de link een sr-only tekst
 * met de naam. Anders is het voor een schermlezer een link zonder naam.
 *
 * De foto komt uit src/assets en gaat via astro:assets, zodat de 1,7 MB grote
 * PNG als kleine WebP bij de bezoeker aankomt.
 */

interface Props {
	name: string;
	href: string;
	image: ImageMetadata;
	/** De grote kaart: twee kolommen en twee rijen in het raster. */
	featured?: boolean;
}

const { name, href, image, featured = false } = Astro.props;

// De grote kaart is op desktop zo'n 670px breed, de kleine zo'n 320px.
const sizes = featured
	? '(min-width: 1400px) 670px, (min-width: 1024px) 48vw, calc(100vw - 32px)'
	: '(min-width: 1400px) 320px, (min-width: 1024px) 23vw, 50vw';
const widths = featured ? [640, 900, 1202] : [320, 480, 640, 900];
---

<a
	href={href}
	class:list={[
		'group relative block aspect-square overflow-hidden rounded-card bg-surface-hover shadow-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg',
		featured && 'col-span-2 row-span-2',
	]}
>
	<Image
		src={image}
		alt=""
		widths={widths}
		sizes={sizes}
		quality={72}
		loading="lazy"
		decoding="async"
		class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
	/>
	<span class="sr-only">{name}</span>
</a>
