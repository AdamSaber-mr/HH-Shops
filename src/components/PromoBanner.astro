---
import { Icon } from 'astro-icon/components';

/*
 * De tussenbanner: een breed blok tussen de productsecties in, met een
 * boodschap en een knop.
 *
 * De afbeelding komt van Adam. Tot die tijd is de achtergrond bosgroen. Zodra
 * `image` gevuld is, ligt de foto achter de tekst met een donker verloop aan
 * de linkerkant, zodat de witte tekst leesbaar blijft. Maak de foto ongeveer
 * 3:1 (bijvoorbeeld 1800 x 600) met de rustige kant links, daar staat de
 * tekst.
 */

interface Props {
	eyebrow?: string;
	title: string;
	text: string;
	cta: { label: string; href: string };
	image?: { url: string; alt: string; width: number; height: number };
}

const { eyebrow, title, text, cta, image } = Astro.props;
---

<section class="mx-auto max-w-[1400px] px-4 sm:px-6" aria-labelledby="promo-titel">
	<div class="relative overflow-hidden rounded-card bg-accent text-white">
		{image && (
			<>
				<img
					src={image.url}
					alt={image.alt}
					width={image.width}
					height={image.height}
					loading="lazy"
					decoding="async"
					class="absolute inset-0 size-full object-cover"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-r from-accent-hover via-accent-hover/70 to-transparent"
					aria-hidden="true"
				>
				</div>
			</>
		)}

		<!-- Zachte cirkels als de foto er nog niet is, zodat het vlak niet plat oogt. -->
		{!image && (
			<div class="pointer-events-none absolute inset-0" aria-hidden="true">
				<div class="absolute -top-24 -right-24 size-96 rounded-full bg-white/5"></div>
				<div class="absolute -right-10 -bottom-40 size-[28rem] rounded-full bg-white/5"></div>
			</div>
		)}

		<div class="relative max-w-xl px-6 py-12 sm:px-10 sm:py-16 lg:px-14 lg:py-20">
			{eyebrow && (
				<p class="text-sm font-semibold tracking-wide text-white/80 uppercase">{eyebrow}</p>
			)}
			<h2
				id="promo-titel"
				class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
			>
				{title}
			</h2>
			<p class="mt-4 max-w-md text-base text-pretty text-white/85 sm:text-lg">{text}</p>
			<a
				href={cta.href}
				class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-control bg-white px-6 text-base font-medium text-accent transition-colors hover:bg-accent-subtle"
			>
				{cta.label}
				<Icon name="ph:arrow-right" class="size-5" aria-hidden="true" />
			</a>
		</div>
	</div>
</section>
