---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

/*
 * De tussenbanner: de foto vult het hele blok, de boodschap ligt erover.
 *
 * De foto is de achtergrond, op elk formaat. Op telefoon stond hij eerst als
 * los plaatje onder een groen tekstvlak; dat leest als twee blokken onder
 * elkaar in plaats van een banner. Nu is het een vlak: producten bovenin, de
 * tekst eronder op een donkergroen verloop dat uit de onderrand opkomt.
 *
 * Op desktop is het blok 8:3 en ligt de tekst links op een verloop naar
 * rechts. Dat is de maat waarop nieuwe tussenbanners worden aangeleverd
 * (2880 x 1080). De huidige foto is 2066 x 761 en dus een fractie breder;
 * daar valt links en rechts samen zo'n 2% af, en dat is alleen achtergrond.
 *
 * Ook hier staat er op telefoon een vaste `sizes` in plaats van een
 * percentage: door de zoom is de foto daar breder uitgetekend dan het
 * venster, en anders haalt de browser een te kleine versie op.
 *
 * Op telefoon en tablet bepaalt een minimumhoogte het blok en snijdt
 * object-cover er een staande strook uit het midden: de knuffelbeer, de
 * ringstapelaar en het houten autootje. Die staan in de onderste helft van de
 * foto, dus de tekst staat daar bovenaan en het verloop komt van boven. Andersom
 * (tekst onderaan) legt het verloop precies over de producten heen en houd je
 * een groen vlak over.
 *
 * De foto komt uit src/assets en gaat via astro:assets, zodat de PNG van
 * 1,7 MB als kleine WebP bij de bezoeker aankomt. Het is nu een afbeelding in
 * plaats van twee.
 */

interface Props {
	eyebrow?: string;
	title: string;
	text: string;
	cta: { label: string; href: string };
	image: ImageMetadata;
	imageAlt: string;
}

const { eyebrow, title, text, cta, image, imageAlt } = Astro.props;
---

<section class="mx-auto max-w-[1400px] px-4 sm:px-6" aria-labelledby="promo-titel">
	<div
		class="relative isolate flex min-h-[30rem] overflow-hidden rounded-card bg-accent-hover text-white sm:min-h-[24rem] lg:aspect-[8/3] lg:min-h-0"
	>
		<Image
			src={image}
			alt={imageAlt}
			widths={[640, 828, 1080, 1200, 1920]}
			sizes="(min-width: 1400px) 1352px, (min-width: 1024px) calc(100vw - 48px), 1500px"
			quality={72}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 size-full object-cover object-center max-lg:origin-[50%_45%] max-lg:scale-[1.15] max-lg:object-[38%_center]"
		/>

		<!-- Verloop over de foto, zodat witte tekst leesbaar blijft: op telefoon
		     van onder naar boven, op desktop van links naar rechts. -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-accent-hover from-35% via-accent-hover/85 via-65% to-accent-hover/10 lg:hidden"
			aria-hidden="true"
		>
		</div>
		<div
			class="absolute inset-y-0 left-0 hidden w-3/5 bg-gradient-to-r from-accent-hover/95 via-accent-hover/65 to-transparent lg:block"
			aria-hidden="true"
		>
		</div>

		<div
			class="relative flex max-w-xl flex-col justify-start px-6 py-10 sm:px-10 sm:py-12 lg:justify-center lg:px-14"
		>
			{eyebrow && (
				<p class="text-sm font-semibold tracking-wide text-white/80 uppercase">{eyebrow}</p>
			)}
			<h2
				id="promo-titel"
				class="mt-2 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
			>
				{title}
			</h2>
			<p class="mt-4 max-w-md text-base text-pretty text-white/85 sm:text-lg">{text}</p>
			<a
				href={cta.href}
				class="mt-8 inline-flex min-h-12 items-center gap-2 self-start rounded-control bg-white px-6 text-base font-medium text-accent transition-colors hover:bg-accent-subtle"
			>
				{cta.label}
				<Icon name="ph:arrow-right" class="size-5" aria-hidden="true" />
			</a>
		</div>
	</div>
</section>
