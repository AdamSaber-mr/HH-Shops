---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { nav, navCategorieen, site } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';

/*
 * De kop van de site: aankondigingsbalk, logo, navigatie, zoeken, winkelwagen.
 *
 * De uitklap onder "Producten" werkt met een <details>, dus zonder JavaScript.
 * Dat is bewust: een menu dat alleen met JavaScript opengaat, gaat op een
 * trage verbinding helemaal niet open.
 */
const logo = afbeelding(site.logo.src);
---

<div class="bg-accent text-center text-sm font-medium text-white">
	<div class="mx-auto max-w-[1200px] px-4 py-2">{site.announcement}</div>
</div>

<header class="border-b border-border bg-surface">
	<div class="mx-auto flex max-w-[1200px] items-center gap-4 px-4 py-3 sm:px-6">
		<a href="/" class="shrink-0 rounded-control">
			<Image src={logo} alt={site.logo.alt} width={150} height={50} quality={85} loading="eager" class="h-10 w-auto" />
		</a>

		<nav aria-label="Hoofdmenu" class="ml-4 hidden lg:block">
			<ul class="flex items-center gap-1">
				{nav.map((item) => (
					<li>
						{item.heeftUitklap ? (
							<details class="group relative">
								<summary class="flex cursor-pointer list-none items-center gap-1 rounded-control px-3 py-2 text-sm font-medium tracking-wide uppercase hover:bg-surface-hover">
									{item.label}
									<Icon name="ph:caret-down" class="size-3.5 transition-transform group-open:rotate-180" />
								</summary>
								<ul class="absolute left-0 z-20 mt-1 w-80 rounded-card border border-border bg-surface p-2 shadow-sm">
									{navCategorieen.map((c) => (
										<li>
											<a href={c.href} class="block rounded-control px-3 py-2 hover:bg-surface-hover">
												<span class="block text-sm font-medium">{c.naam}</span>
												<span class="block text-xs text-text-muted">{c.omschrijving}</span>
											</a>
										</li>
									))}
								</ul>
							</details>
						) : (
							<a href={item.href} class="block rounded-control px-3 py-2 text-sm font-medium tracking-wide uppercase hover:bg-surface-hover">
								{item.label}
							</a>
						)}
					</li>
				))}
			</ul>
		</nav>

		<div class="ml-auto flex items-center gap-2">
			<a href="/winkelwagen" class="flex min-h-11 items-center gap-2 rounded-control px-3 text-sm hover:bg-surface-hover">
				<Icon name="ph:shopping-cart-simple" class="size-5" />
				<span class="hidden sm:inline">€&nbsp;0,00</span>
				<span class="sr-only">Winkelwagen, 0 artikelen</span>
			</a>
			<a href="/winkel" class="inline-flex min-h-11 items-center rounded-control bg-accent px-4 text-sm font-medium text-white hover:bg-accent-hover">
				Shop nu!
			</a>
		</div>
	</div>
</header>
