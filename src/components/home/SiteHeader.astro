---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { nav, navCategorieen, site } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';

/*
 * De kop van de site.
 *
 * Blijft plakken bij het scrollen, want op een winkel met negentig artikelen wil
 * je onderweg kunnen zoeken zonder terug naar boven te scrollen.
 *
 * De balk met "SHOP NU!" die op de oude site boven de kop stond is weg. Die zei
 * niets: je staat al in een winkel. De ruimte die dat oplevert gaat naar het
 * zoekveld, dat hier meer werk doet.
 *
 * De uitklap onder Producten werkt met <details>, dus zonder JavaScript. Een
 * menu dat alleen met JavaScript opengaat, gaat op een trage verbinding
 * helemaal niet open.
 */
const logo = afbeelding(site.logo.src);
---

<header
	class="sticky top-0 z-30 border-b border-border bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/75"
>
	<div class="mx-auto flex h-16 max-w-[1400px] items-center gap-3 px-4 sm:px-6">
		<a href="/" class="shrink-0 rounded-control">
			<!--
				De verhouding hier moet die van het bestand volgen (446 bij 212),
				anders reserveert de browser de verkeerde ruimte en verspringt de
				kop tijdens het laden. Stond op 150 bij 50, wat 3:1 is.

				Ronde hoeken omdat het logo een zwart vlak is: zonder afronding
				staat er een hard blok in een kop waar verder alles rond is.
			-->
			<Image
				src={logo}
				alt={site.logo.alt}
				width={168}
				height={80}
				quality={92}
				loading="eager"
				class="h-9 w-auto rounded-control"
			/>
		</a>

		<nav aria-label="Hoofdmenu" class="ml-2 hidden lg:block">
			<ul class="flex items-center gap-0.5">
				{
					nav.map((item) => (
						<li>
							{item.heeftUitklap ? (
								<details class="group relative">
									<summary class="flex min-h-10 cursor-pointer list-none items-center gap-1 rounded-control px-3 text-sm font-semibold transition-colors hover:bg-surface-hover">
										{item.label}
										<Icon
											name="ph:caret-down"
											class="size-3.5 transition-transform group-open:rotate-180"
										/>
									</summary>
									<ul class="absolute left-0 z-20 mt-2 w-80 rounded-card border border-border bg-surface p-2 shadow-lg shadow-text/5">
										{navCategorieen.map((c) => (
											<li>
												<a
													href={c.href}
													class="block rounded-control px-3 py-2.5 transition-colors hover:bg-surface-hover"
												>
													<span class="block text-sm font-semibold">{c.naam}</span>
													<span class="block text-xs text-text-muted">{c.omschrijving}</span>
												</a>
											</li>
										))}
									</ul>
								</details>
							) : (
								<a
									href={item.href}
									class="flex min-h-10 items-center rounded-control px-3 text-sm font-semibold transition-colors hover:bg-surface-hover"
								>
									{item.label}
								</a>
							)}
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Zoeken in de kop, zodat het meescrollt met de pagina. -->
		<search class="ml-auto hidden max-w-xs flex-1 md:block">
			<form action="/winkel">
				<label for="zoeken-kop" class="sr-only">Producten zoeken</label>
				<div class="relative">
					<Icon
						name="ph:magnifying-glass"
						class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-text-muted"
					/>
					<input
						id="zoeken-kop"
						name="q"
						type="search"
						placeholder="Zoeken"
						class="min-h-10 w-full rounded-control border border-border-strong bg-canvas pr-3 pl-9 text-sm placeholder:text-text-muted"
					/>
				</div>
			</form>
		</search>

		<a
			href="/winkelwagen"
			class="ml-auto flex min-h-10 items-center gap-2 rounded-control px-3 text-sm font-semibold transition-colors hover:bg-surface-hover md:ml-2"
		>
			<Icon name="ph:shopping-cart-simple" class="size-5" />
			<span class="hidden sm:inline tabular-nums">€&nbsp;0,00</span>
			<span class="sr-only">Winkelwagen, 0 artikelen</span>
		</a>
	</div>
</header>
