---
import { Image } from 'astro:assets';
import { instagram } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';

/*
 * Vaste strook, geen koppeling.
 *
 * Op de oude site haalt een plugin dit live op. De foto-URL's van Instagram
 * zijn ondertekend en verlopen, dus doorlinken zou binnen een dag gebroken
 * plaatjes geven. Deze vier staan in de repo.
 */
---

<section aria-labelledby="instagram-titel" class="opkomen">
	<div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 sm:py-16">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<a href={instagram.profiel} rel="noopener noreferrer" target="_blank" class="flex items-center gap-3 rounded-control">
				<Image
					src={afbeelding(instagram.avatar.src)}
					alt={instagram.avatar.alt}
					width={48}
					height={48}
					quality={80}
					class="size-12 rounded-full object-cover"
				/>
				<h2 id="instagram-titel" class="font-semibold">{instagram.handle}</h2>
			</a>
			<a
				href={instagram.knop.href}
				rel="noopener noreferrer"
				target="_blank"
				class="inline-flex min-h-11 items-center rounded-control border border-border-strong bg-surface px-4 text-sm font-medium hover:bg-surface-hover"
			>
				{instagram.knop.label}
			</a>
		</div>

		<ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
			{instagram.berichten.map((b) => (
				<li>
					<a href={b.href} rel="noopener noreferrer" target="_blank" class="lift zoom block overflow-hidden rounded-card border border-border">
						<Image
							src={afbeelding(b.src)}
							alt={b.alt}
							widths={[240, 320, 480]}
							sizes="(min-width: 640px) 280px, 45vw"
							quality={72}
							class="aspect-square w-full object-cover"
						/>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
