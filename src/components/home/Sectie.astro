---
/* Vaste breedte en ruimte voor elke sectie van de startpagina. */
interface Props {
	class?: string;
	/** Lichte achtergrond in plaats van de paginakleur. */
	surface?: boolean;
	labelledby?: string;
}
const { class: extra = '', surface = false, labelledby } = Astro.props;
---

<section
	class={`${surface ? 'bg-surface' : ''} ${extra}`}
	aria-labelledby={labelledby}
>
	<div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 sm:py-16">
		<slot />
	</div>
</section>
