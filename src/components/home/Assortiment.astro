---
import { Image } from 'astro:assets';
import { assortiment } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';

/*
 * Alle negen categorieen als horizontale strook met scroll-snap.
 *
 * De hero toont er al vier als grote tegels. Diezelfde vorm hier nog eens
 * herhalen zou de pagina eentonig maken, dus dit is bewust een andere vorm:
 * kleiner, dichter, en je veegt er doorheen. Op telefoon is dat sowieso
 * prettiger dan negen vierkanten onder elkaar.
 */
---

<section aria-labelledby="assortiment-titel" class="opkomen bg-surface">
	<div class="mx-auto max-w-[1400px] py-14 sm:py-20">
		<h2
			id="assortiment-titel"
			class="px-4 text-2xl font-bold tracking-tight sm:px-6 sm:text-3xl"
		>
			{assortiment.titel}
		</h2>

		<ul
			class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:px-6 [scrollbar-width:thin]"
		>
			{
				assortiment.categorieen.map((c) => (
					<li class="w-40 shrink-0 snap-start sm:w-48">
						<a href={c.href} class="lift zoom group block overflow-hidden rounded-card border border-border bg-canvas">
							<div class="aspect-square overflow-hidden">
								<Image
									src={afbeelding(c.afbeelding)}
									alt={`Categorie ${c.naam}`}
									widths={[192, 288, 384]}
									sizes="192px"
									quality={72}
									class="size-full object-cover"
								/>
							</div>
							<h3 class="px-3 py-3 text-sm font-semibold">{c.naam}</h3>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
