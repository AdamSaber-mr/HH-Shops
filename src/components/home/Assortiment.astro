---
import { Image } from 'astro:assets';
import { assortiment } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';
---

<section aria-labelledby="assortiment-titel" class="bg-surface">
	<div class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 sm:py-16">
		<h2 id="assortiment-titel" class="text-center text-2xl font-semibold tracking-tight sm:text-3xl">
			{assortiment.titel}
		</h2>

		<ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
			{assortiment.categorieen.map((c) => (
				<li class="group relative">
					<a href={c.href} class="block rounded-card border border-border bg-canvas p-3 text-center transition-colors hover:bg-surface-hover">
						<div class="aspect-square overflow-hidden rounded-control">
							<Image
								src={afbeelding(c.afbeelding)}
								alt={`Categorie ${c.naam}`}
								widths={[240, 320, 480]}
								sizes="(min-width: 1024px) 210px, (min-width: 640px) 30vw, 45vw"
								quality={72}
								class="size-full object-cover"
							/>
						</div>
						<h3 class="mt-3 text-sm font-medium">{c.naam}</h3>
					</a>
				</li>
			))}
		</ul>
	</div>
</section>
