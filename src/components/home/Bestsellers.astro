---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { bestsellers } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';
import { formatEuro } from '../../lib/price.ts';

/*
 * Kop links, knop rechts op dezelfde regel. Op de oude site staat alles
 * gecentreerd; als elke sectie dat doet krijgt de pagina geen ritme en scrol je
 * zeven keer langs hetzelfde patroon.
 */
---

<section aria-labelledby="bestsellers-titel" class="opkomen">
	<div class="mx-auto max-w-[1400px] px-4 py-14 sm:px-6 sm:py-20">
		<div class="flex flex-wrap items-end justify-between gap-4">
			<div>
				<h2 id="bestsellers-titel" class="text-2xl font-bold tracking-tight sm:text-3xl">
					{bestsellers.titel}
				</h2>
				<p class="mt-1.5 text-text-muted">{bestsellers.tekst}</p>
			</div>
			<a
				href={bestsellers.knop.href}
				class="inline-flex min-h-11 items-center gap-1.5 rounded-control border border-border-strong bg-surface px-4 text-sm font-semibold transition-colors hover:bg-surface-hover"
			>
				{bestsellers.knop.label}
				<Icon name="ph:arrow-right" class="size-4" />
			</a>
		</div>

		<ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
			{
				bestsellers.producten.map((p) => (
					<li class="lift group relative flex flex-col rounded-card border border-border bg-surface">
						<div class="zoom aspect-square overflow-hidden rounded-t-card bg-canvas">
							<Image
								src={afbeelding(p.afbeelding)}
								alt={p.alt}
								widths={[240, 320, 480]}
								sizes="(min-width: 1024px) 250px, (min-width: 640px) 30vw, 45vw"
								quality={75}
								class="size-full object-cover"
							/>
						</div>
						<div class="flex flex-1 flex-col gap-1.5 p-4">
							<h3 class="text-sm leading-snug font-medium">
								<a href={p.href} class="after:absolute after:inset-0">{p.naam}</a>
							</h3>
							<p class="mt-auto pt-2 text-lg font-bold tracking-tight text-accent">
								{formatEuro(p.prijsCents)}
							</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
