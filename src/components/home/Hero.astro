---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { beoordeling, hero } from '../../content/homepage.ts';
import { afbeelding } from '../../lib/images.ts';

/*
 * Hero als categorie-mozaiek.
 *
 * Het tekstvlak is zelf een tegel in het raster en geen laag over een foto.
 * Dat is met opzet: tekst over beeld vraagt om een donkere waas, die waas
 * verpest de foto, en het contrast blijft alsnog afhankelijk van welke foto er
 * toevallig onder ligt. Zo is het contrast gegarandeerd en blijft het beeld
 * schoon.
 *
 * Het raster is asymmetrisch, want vier gelijke vierkanten naast elkaar is
 * precies het patroon dat elke sjabloonwebsite gebruikt.
 *
 * Over de hoogte, want daar ging het eerder mis.
 *
 * De hoogte wordt bepaald door de TEGELKOLOM en niet door de buitenste
 * container. Die kolom heeft vanaf md een vaste hoogte met twee rijen die de
 * ruimte eerlijk delen, zodat de foto's zich naar het kader voegen.
 *
 * Zet die hoogte NIET op de container eromheen. Dat had ik eerst gedaan, en dan
 * dwingt hij de foto's tot niets: die groeien door tot hun eigen formaat en
 * lopen over de secties eronder heen. De minmax(0,1fr) is daarbij het stuk dat
 * telt, want zonder die nul mag een rij alsnog groter worden dan zijn deel.
 *
 * Zo kan het tekstvlak bovendien nooit klemzitten: heeft dat meer ruimte nodig,
 * dan groeit de hero gewoon mee in plaats van te overlappen.
 *
 * Zoeken staat vooraan en niet de knop. Dit is een winkel met ruim 90
 * artikelen: wie hier komt zoekt meestal iets specifieks.
 */

const tegels = [
	{ naam: 'Huishoudelijke artikelen', bestand: 'huishoudelijke-artikelen', span: 'md:col-span-2' },
	{ naam: 'Kinder artikelen', bestand: 'kinder-artikelen', span: 'md:col-span-1' },
	{ naam: 'Cosmetica artikelen', bestand: 'cosmetica-artikelen', span: 'md:col-span-1' },
	{ naam: 'Tassen', bestand: 'tassen', span: 'md:col-span-2' },
];
---

<section class="border-b border-border bg-surface md:flex md:flex-1 md:flex-col">
	<div class="mx-auto flex w-full max-w-[1400px] flex-col px-4 pt-4 pb-8 sm:px-6 sm:pt-6 sm:pb-10 md:flex-1">
		<div class="grid gap-3 md:flex-1 md:grid-cols-[1.05fr_1fr]">
			<!-- Tekstvlak, zelf een tegel in het mozaiek -->
			<div
				class="flex flex-col justify-center rounded-media bg-accent px-6 py-7 text-white sm:px-8 sm:py-8 lg:px-10"
			>
				<h1 class="text-3xl leading-[1.06] font-extrabold tracking-tight text-balance sm:text-4xl lg:text-5xl">
					{hero.titel}
				</h1>
				<p class="mt-3 max-w-md leading-relaxed text-white/85">
					{hero.tekst}
				</p>

				<search class="mt-6">
					<form class="flex flex-col gap-2 sm:flex-row" action="/winkel">
						<label for="zoeken" class="sr-only">Producten zoeken</label>
						<div class="relative flex-1">
							<Icon
								name="ph:magnifying-glass"
								class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-text-muted"
							/>
							<input
								id="zoeken"
								name="q"
								type="search"
								placeholder={hero.zoekPlaceholder}
								class="min-h-12 w-full rounded-control bg-surface pr-4 pl-11 text-text placeholder:text-text-muted"
							/>
						</div>
						<button
							type="submit"
							class="min-h-12 rounded-control bg-text px-6 font-semibold text-white transition-colors hover:bg-text/85"
						>
							Zoeken
						</button>
					</form>
				</search>

				<!--
					De beoordeling staat hier en niet in de trustbalk, omdat dit het enige
					harde bewijs op de pagina is en het dus meteen in beeld hoort.

					Let op: dit is de 8,1 van bol.com die de klant zelf op zijn site
					claimt. Er is geen Google-beoordeling en er is geen reviewsysteem in
					de shop, dus verzin hier nooit een ander getal bij.
				-->
				<p class="mt-5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm">
					<span
						class="flex gap-0.5 text-white"
						role="img"
						aria-label={`${beoordeling.cijfer} van de 10`}
					>
						{Array.from({ length: 4 }).map(() => <Icon name="ph:star-fill" class="size-4" />)}
						<Icon name="ph:star-half-fill" class="size-4" />
					</span>
					<span class="font-semibold">{beoordeling.cijfer}</span>
					<span class="text-white/80">{beoordeling.bron}</span>
				</p>
			</div>

			<!-- Beeldtegels -->
			<ul class="grid grid-cols-2 gap-3 md:h-full md:grid-cols-3 md:grid-rows-[minmax(0,1fr)_minmax(0,1fr)]">
				{
					tegels.map((t) => (
						<li class={`${t.span} lift zoom min-h-0 overflow-hidden rounded-media`}>
							<a href={`/categorie/${t.bestand}`} class="group relative block aspect-4/3 size-full md:aspect-auto">
								<Image
									src={afbeelding(`~/assets/site/categorieen/${t.bestand}.png`)}
									alt={`Categorie ${t.naam}`}
									widths={[320, 480, 640]}
									sizes="(min-width: 1024px) 320px, (min-width: 768px) 25vw, 45vw"
									quality={74}
									loading="eager"
									class="size-full object-cover"
								/>
								<span class="absolute inset-x-3 bottom-3 rounded-control bg-surface/95 px-3 py-1.5 text-xs font-semibold">
									{t.naam}
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
