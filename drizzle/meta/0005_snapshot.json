			"checkConstraints": {
				"categories_slug_format": {
					"name": "categories_slug_format",
					"value": "\"categories\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$' AND length(\"categories\".\"slug\") BETWEEN 2 AND 80"
				},
				"categories_name_shape": {
					"name": "categories_name_shape",
					"value": "btrim(\"categories\".\"name\") = \"categories\".\"name\" AND length(\"categories\".\"name\") BETWEEN 2 AND 80"
				},
				"categories_name_clean": {
					"name": "categories_name_clean",
					"value": "\"categories\".\"name\" !~ ('&(#[0-9]+|[a-zA-Z]+)' || chr(59))\n\t    AND position(chr(8211) in \"categories\".\"name\") = 0\n\t    AND position(chr(8212) in \"categories\".\"name\") = 0"
				},
				"categories_description_not_blank": {
					"name": "categories_description_not_blank",
					"value": "\"categories\".\"description\" IS NULL OR btrim(\"categories\".\"description\") <> ''"
				},
				"categories_image_pair": {
					"name": "categories_image_pair",
					"value": "(\"categories\".\"image_url\" IS NULL) = (\"categories\".\"image_alt\" IS NULL)"
				},
				"categories_image_alt_quality": {
					"name": "categories_image_alt_quality",
					"value": "\"categories\".\"image_alt\" IS NULL OR (\n\t\t\t      btrim(\"categories\".\"image_alt\") = \"categories\".\"image_alt\"\n\t\t\t      AND length(\"categories\".\"image_alt\") BETWEEN 5 AND 250)"
				},
				"categories_image_dimensions": {
					"name": "categories_image_dimensions",
					"value": "((\"categories\".\"image_url\" IS NULL) = (\"categories\".\"image_width\" IS NULL))\n\t\t\t    AND ((\"categories\".\"image_url\" IS NULL) = (\"categories\".\"image_height\" IS NULL))\n\t\t\t    AND (\"categories\".\"image_width\" IS NULL OR \"categories\".\"image_width\" BETWEEN 1 AND 10000)\n\t\t\t    AND (\"categories\".\"image_height\" IS NULL OR \"categories\".\"image_height\" BETWEEN 1 AND 10000)"
				},
				"categories_image_url_shape": {
					"name": "categories_image_url_shape",
					"value": "\"categories\".\"image_url\" IS NULL OR (\"categories\".\"image_url\" ~ '^https://'\n\t\t\t    AND \"categories\".\"image_url\" NOT LIKE '%/wp-content/%'\n\t\t\t    AND length(\"categories\".\"image_url\") BETWEEN 5 AND 500)"
				},
				"categories_banner_pair": {
					"name": "categories_banner_pair",
					"value": "(\"categories\".\"banner_url\" IS NULL) = (\"categories\".\"banner_alt\" IS NULL)"
				},
				"categories_banner_alt_quality": {
					"name": "categories_banner_alt_quality",
					"value": "\"categories\".\"banner_alt\" IS NULL OR (\n\t\t\t      btrim(\"categories\".\"banner_alt\") = \"categories\".\"banner_alt\"\n\t\t\t      AND length(\"categories\".\"banner_alt\") BETWEEN 5 AND 250)"
				},
				"categories_banner_dimensions": {
					"name": "categories_banner_dimensions",
					"value": "((\"categories\".\"banner_url\" IS NULL) = (\"categories\".\"banner_width\" IS NULL))\n\t\t\t    AND ((\"categories\".\"banner_url\" IS NULL) = (\"categories\".\"banner_height\" IS NULL))\n\t\t\t    AND (\"categories\".\"banner_width\" IS NULL OR \"categories\".\"banner_width\" BETWEEN 1 AND 10000)\n\t\t\t    AND (\"categories\".\"banner_height\" IS NULL OR \"categories\".\"banner_height\" BETWEEN 1 AND 10000)"
				},
				"categories_banner_url_shape": {
					"name": "categories_banner_url_shape",
					"value": "\"categories\".\"banner_url\" IS NULL OR (\"categories\".\"banner_url\" ~ '^https://'\n\t\t\t    AND \"categories\".\"banner_url\" NOT LIKE '%/wp-content/%'\n\t\t\t    AND length(\"categories\".\"banner_url\") BETWEEN 5 AND 500)"
				},
				"categories_banner_title_shape": {
					"name": "categories_banner_title_shape",
					"value": "\"categories\".\"banner_title\" IS NULL OR (btrim(\"categories\".\"banner_title\") = \"categories\".\"banner_title\"\n\t\t\t    AND length(\"categories\".\"banner_title\") BETWEEN 3 AND 120)"
				},
				"categories_banner_title_clean": {
					"name": "categories_banner_title_clean",
					"value": "\"categories\".\"banner_title\" IS NULL OR (\"categories\".\"banner_title\" !~ ('&(#[0-9]+|[a-zA-Z]+)' || chr(59))\n\t    AND position(chr(8211) in \"categories\".\"banner_title\") = 0\n\t    AND position(chr(8212) in \"categories\".\"banner_title\") = 0)"
				},
				"categories_no_self_parent": {
					"name": "categories_no_self_parent",
					"value": "\"categories\".\"parent_id\" IS NULL OR \"categories\".\"parent_id\" <> \"categories\".\"id\""
				},
				"categories_position_nonneg": {
					"name": "categories_position_nonneg",
					"value": "\"categories\".\"position\" >= 0"
